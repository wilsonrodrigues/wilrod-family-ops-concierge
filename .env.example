# Family Ops Concierge - Environment & Secret Manager Configuration Template
# Copy to `.env` for local development. NEVER commit real API keys to Git.

# Option A (Production / Cloud Run - Recommended):
# Resolve secrets dynamically from Google Cloud Secret Manager
GOOGLE_CLOUD_PROJECT=
USE_SECRET_MANAGER=0
GEMINI_API_KEY_SECRET_ID=family-ops-gemini-api-key

# Option B (Local Development Fallback):
# Injected via local git-ignored `.env` when USE_SECRET_MANAGER=0
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=

# Optional Google Cloud Observability & Sensitive Data Protection (Cloud DLP)
ENABLE_CLOUD_DLP=0
FAMILY_MODEL_FAST=gemini-3.5-flash-lite
FAMILY_MODEL_FLASH=gemini-3.8-flash
FAMILY_MODEL_PRO=gemini-3.1-pro-preview
